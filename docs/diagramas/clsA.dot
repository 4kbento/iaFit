digraph G{rankdir=TB;nodesep=0.28;ranksep=0.9;bgcolor=white;node[shape=plain,fontname="Helvetica"];edge[color="#5B2236",penwidth=1.5,fontname="Helvetica",fontsize=14,arrowsize=0.8];
Usuario[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ email</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ senha_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ data_nascimento</FONT></TD></TR></TABLE>>];
Perfil[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Perfil</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ altura_cm</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ objetivo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ nivel_atividade</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ dias_treino_semana</FONT></TD></TR></TABLE>>];
Consentimento[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Consentimento</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ versao</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ aceito</FONT></TD></TR></TABLE>>];
RegistroProgresso[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>RegistroProgresso</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ data</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ peso_kg</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ treinou</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ seguiu_dieta</FONT></TD></TR></TABLE>>];
RestricaoAlimentar[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>RestricaoAlimentar</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ nome</FONT></TD></TR></TABLE>>];
Conversa[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Conversa</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ criada_em</FONT></TD></TR></TABLE>>];
Mensagem[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Mensagem</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ autor</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ texto</FONT></TD></TR></TABLE>>];
Usuario->Perfil[taillabel="1",headlabel="1",labeldistance=1.6,arrowhead=vee];
Usuario->Consentimento[taillabel="1",headlabel="*",labeldistance=1.6,arrowhead=vee];
Usuario->RegistroProgresso[taillabel="1",headlabel="*",labeldistance=1.6,arrowhead=vee];
Usuario->RestricaoAlimentar[taillabel="*",headlabel="*",labeldistance=1.6,arrowhead=vee];
Usuario->Conversa[taillabel="1",headlabel="*",labeldistance=1.6,arrowhead=vee];
Conversa->Mensagem[taillabel="1",headlabel="*",labeldistance=1.6,arrowtail=diamond,dir=both,arrowhead=none];
}