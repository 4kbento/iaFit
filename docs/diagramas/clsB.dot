digraph G{rankdir=LR;nodesep=0.28;ranksep=0.9;bgcolor=white;node[shape=plain,fontname="Helvetica"];edge[color="#5B2236",penwidth=1.5,fontname="Helvetica",fontsize=14,arrowsize=0.8];
Usuario[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ email</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ senha_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ data_nascimento</FONT></TD></TR></TABLE>>];
PlanoAlimentar[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>PlanoAlimentar</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ kcal_meta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ modelo_ia</FONT></TD></TR></TABLE>>];
Refeicao[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Refeicao</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ horario</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ nome</FONT></TD></TR></TABLE>>];
Alimento[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Alimento</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ kcal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ proteina</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ carbo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ gordura</FONT></TD></TR></TABLE>>];
PlanoTreino[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>PlanoTreino</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ modelo_ia</FONT></TD></TR></TABLE>>];
TreinoDia[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>TreinoDia</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ dia_semana</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ nome</FONT></TD></TR></TABLE>>];
Exercicio[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>Exercicio</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ grupo_muscular</FONT></TD></TR></TABLE>>];
SessaoTreino[label=<<TABLE BORDER="1" COLOR="#5B2236" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F6E9EC"><TR><TD BGCOLOR="#5B2236"><FONT COLOR="white" POINT-SIZE="17"><B>SessaoTreino</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ data</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">+ concluida</FONT></TD></TR></TABLE>>];
Usuario->PlanoAlimentar[taillabel="1",headlabel="*",labeldistance=1.6,arrowhead=vee];
PlanoAlimentar->Refeicao[taillabel="1",headlabel="*",labeldistance=1.6,arrowtail=diamond,dir=both,arrowhead=none];
Refeicao->Alimento[taillabel="*",headlabel="*",labeldistance=1.6,arrowhead=vee];
Usuario->PlanoTreino[taillabel="1",headlabel="*",labeldistance=1.6,arrowhead=vee];
PlanoTreino->TreinoDia[taillabel="1",headlabel="*",labeldistance=1.6,arrowtail=diamond,dir=both,arrowhead=none];
TreinoDia->Exercicio[taillabel="*",headlabel="*",labeldistance=1.6,arrowhead=vee];
Usuario->SessaoTreino[taillabel="1",headlabel="*",labeldistance=1.6,arrowhead=vee];
}